# Reference copy of the env file at /etc/bite.env on the droplet
# (EnvironmentFile= in bite.service). Fill in real values there — never
# commit the actual file, since JWT_SECRET is a real secret.
PORT=8080
DB_PATH=/opt/bite/bite.db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://bite.mhakash.com
COOKIE_SAMESITE=none
