# Copy this to deploy.env (gitignored) and fill in your real droplet
# details. deploy.sh and rollback.sh source it automatically if present.
# Never commit deploy.env — it's the only place the droplet's real IP and
# key path should live.
DROPLET_HOST=root@your.droplet.ip
SSH_KEY=~/.ssh/your_key
REMOTE_DIR=/opt/bite
